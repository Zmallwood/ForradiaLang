Import Core.WorldStructure.World
Import Core.CoreGameObjects.Player
Import Core.Configuration.GameProperties

Class WorldView
    Fn Draw
        Double tileWidth = GameProperties.kTileWidth
        Double tileHeight = ConvertWidthToHeight(tileWidth)

        Point playerPosition = gPlayer.position

        WorldArea worldArea = gWorld.currentWorldArea

        Size size = worldArea.GetSize

        Const Double kSmallValue = 0.001

        Const Int gridSize = GameProperties.kGridSize

        For y = 0 To gridSize - 1
            For x = 0 To gridSize - 1
                Int xCoordinate = playerPosition.x - (gridSize - 1)/2 + x
                Int yCoordinate = playerPosition.y - (gridSize - 1)/2 + y

                If Not worldArea.IsValidCoordinate(xCoordinate, yCoordinate) Then
                    Continue
                End

                Tile? tile = worldArea.GetTile(xCoordinate, yCoordinate)

                If tile == Nothing Then
                    Continue
                End

                String groundType = tile.groundType

                Double xPx = 0.5 - tileWidth/2 + x*tileWidth/2 - y*tileWidth/2
                Double yPx = 0.5 - gridSize/2.0*tileHeight + x*tileHeight/2 + y*tileHeight/2
                Double widthPx = tileWidth + kSmallValue
                Double heightPx = tileHeight + kSmallValue

                If xPx + widthPx < 0.0 Or _
                    yPx + heightPx < 0.0 Or _
                    xPx > 1.0 Or _
                    yPx > 1.0 Then
                    Continue
                End
                
                If Not groundType == String.Empty Then
                    If groundType == "GroundWater" Then
                        Int animIndex = ((Now() + 10 * xCoordinate * yCoordinate) % 900) / 300

                        groundType = "GroundWater_" + animIndex.ToString()
                    End

                    DrawImage groundType, xPx, yPx, widthPx, heightPx
                End

                Object? object = tile.object

                If object != Nothing Then
                    Size imageSize = GetImageSize(object.type)

                    Double imageWidthPx = imageSize.width/60.0 * widthPx
                    Double imageHeightPx = imageSize.height/60.0 * heightPx
                    Double imageXPx = xPx + widthPx/2 - imageWidthPx/2
                    Double imageYPx = yPx + heightPx/2 - imageHeightPx

                    DrawImage object.type, imageXPx, imageYPx, imageWidthPx, imageHeightPx
                End

                If x == (gridSize - 1)/2 And y == (gridSize - 1)/2 Then
                    DrawImage "Player", xPx, yPx - heightPx/2, widthPx, heightPx
                End
            Next
        Next
    End
End

WorldView gWorldView