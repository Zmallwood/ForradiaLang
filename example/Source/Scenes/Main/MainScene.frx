Import Sub.WorldView
Import Sub.KeyboardMovement
Import Sub.TileHovering

Scene MainScene
    Update
        gKeyboardMovement.Update

        gTileHovering.Update
    End

    OnKeyDown(Keys key)
        gKeyboardMovement.OnKeyDown key
    End

    OnKeyUp(Keys key)
        gKeyboardMovement.OnKeyUp key
    End

    Draw
        gWorldView.Draw
    End
End

MainScene gMainScene