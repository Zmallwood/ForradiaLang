Scene MainMenuScene
    Update
    End

    OnMouseDown(MouseButtons button)
        GoToScene "WorldGenerationScene"
    End

    OnKeyDown(Keys key)
        GoToScene "WorldGenerationScene"
    End

    Draw
        DrawImage "DefaultSceneBackground", 0.0, 0.0, 1.0, 1.0

        DrawImage "ForradiaLogo", 0.3, 0.1, 0.4, 0.2
    End
End

MainMenuScene gMainMenuScene