Import Tile
Import Core.Configuration.GameProperties

Class WorldArea
    List<List<Tile>> tiles

    New
        Size size = GameProperties.kWorldAreaSize

        For x = 0 To size.width - 1
            tiles.Add(List<Tile>())

            For y = 0 To size.height - 1
                tiles[x].Add(Tile())
            Next
        Next
    End

    Fn GetSize As Size
        Int width = 0
        Int height = 0

        If tiles.Count > 0 Then
            width = tiles.Count
        End

        If width > 0 Then
            height = tiles[0].Count
        End

        Return Size(width, height)
    End

    Fn IsValidCoordinate(Int x, Int y) As Boolean
        Size size = GetSize

        Return x >= 0 And y >= 0 And x < size.width And y < size.height
    End

    Fn GetTile(Int x, Int y) As Tile?
        If IsValidCoordinate(x, y) Then
            Return tiles[x][y]
        End

        Return Nothing
    End
End