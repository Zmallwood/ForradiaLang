Import Tile
Import Core.Configuration.GameProperties

Class WorldArea
    List<List<Tile>> tiles

    New
        Size size = GameProperties.kWorldAreaSize

        For x = 0 To size.width - 1
            tiles.Add(List<Tile>())

            For y = 0 To size.height - 1
                tiles[x].Add(Tile())
            Next
        Next
    End
End