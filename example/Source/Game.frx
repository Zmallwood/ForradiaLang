Import Scenes.Intro.IntroScene
Import Scenes.MainMenu.MainMenuScene
Import Scenes.WorldGeneration.WorldGenerationScene
Import Scenes.Main.MainScene

Class Game
    Fn Start
        InitializeGraphics 0, 0, 0, 0, FRD_Fullscreen, "Forradia"

        LoadImages "../Resources/Images"

        InitializeText "../Resources/Fonts/PixeloidSans.ttf"

        AddFontSizes [12, 18, 24]

        ColorD clearColor(0.0, 0.7, 1.0, 1.0)

        SetClearColor clearColor

        AddCursorStyle "Default", "CursorDefault"
        AddCursorStyle "Hovering", "CursorHovering"

        SetDefaultCursorStyle "Default"

        AddScene "IntroScene", gIntroScene
        AddScene "MainMenuScene", gMainMenuScene
        AddScene "WorldGenerationScene", gWorldGenerationScene
        AddScene "MainScene", gMainScene

        GoToScene "IntroScene"
    End
End